function setActiveSection(sectionId){

    dashboardSections.forEach(section => {

        section.classList.toggle(
            'active',
            section.id === `section-${sectionId}`
        );

    });

    menuLinks.forEach(link => {

        link.classList.toggle(
            'active',
            link.dataset.section === sectionId
        );

    });

    if(sectionId === 'calendar'){

        renderCalendar(calendarMonth, calendarYear);

    }

    if(sectionId === 'tasks'){

        renderAllTasks();

    }

    if(sectionId === 'sessions'){

        renderSessions();

    }

}

menuLinks.forEach(link => {

    link.addEventListener('click', event => {

        event.preventDefault();

        setActiveSection(link.dataset.section);

    });

});

sectionTriggers.forEach(trigger => {

    trigger.addEventListener('click', () => {

        setActiveSection(trigger.dataset.sectionTrigger);

    });

});

/* =========================
   REAL TASKS
========================= */

function formatDate(date){

    const year =
        date.getFullYear();

    const month =
        String(date.getMonth() + 1).padStart(2, '0');

    const day =
        String(date.getDate()).padStart(2, '0');

    return `${year}-${month}-${day}`;

}

function normalizeTask(task){

    return {
        id: task.id,
        title: task.title || 'Tarea sin título',
        due_date: task.due_date || formatDate(today),
        priority: task.priority || 'media',
        duration_minutes: Number(task.duration_minutes) || 30,
        completed: Boolean(task.completed),
    };

}

function getPriorityClass(priority){

    const normalized =
        String(priority || 'media').toLowerCase();

    if(normalized === 'alta') return 'high';

    if(normalized === 'baja') return 'low';

    return 'medium';

}

function getPriorityIcon(priority){

    const normalized =
        String(priority || 'media').toLowerCase();

    if(normalized === 'alta') return 'purple';

    if(normalized === 'baja') return 'blue';

    return 'orange';

}

function createTaskElement(task){

    const taskElement =
        document.createElement('div');

    taskElement.className =
        `task${task.completed ? ' completed' : ''}`;

    taskElement.dataset.taskId =
        task.id;

    taskElement.innerHTML = `
        <div class="task-left">
            <input type="checkbox" ${task.completed ? 'checked' : ''}>
            <div class="task-icon ${getPriorityIcon(task.priority)}">
                <i class="ri-file-list-3-line"></i>
            </div>
            <span>${task.title}</span>
        </div>

        <div class="task-meta">
            <span class="badge ${getPriorityClass(task.priority)}">
                ${task.priority}
            </span>
            <small>${task.duration_minutes} min</small>
            <button class="task-menu" title="Eliminar tarea">
                <i class="ri-delete-bin-line"></i>
            </button>
        </div>
    `;

    const checkbox =
        taskElement.querySelector('input');

    checkbox.addEventListener('change', () => {

        updateTask(task.id, {
            completed: checkbox.checked,
        });

    });

    const menuButton =
        taskElement.querySelector('.task-menu');

    if(menuButton){

        menuButton.addEventListener('click', (e) => {

            e.stopPropagation();

            deleteTask(task.id);

        });

    }

    return taskElement;

}

async function fetchTasks(){

    /* SHOW SKELETONS */

    const skeletonHtml =
        Array(3).fill('<div class="skeleton skeleton-task"></div>').join('');

    if(todayTaskList) todayTaskList.innerHTML = skeletonHtml;
    if(allTaskList) allTaskList.innerHTML = skeletonHtml;

    try{

        const response =
            await fetch(`${API_URL}/tasks`, {
                headers: getAuthHeaders(),
            });

        if(response.status === 401){
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            window.location.href = 'login.html';
            return;
        }

        if(!response.ok) throw new Error('No se pudieron cargar las tareas');

        const data =
            await response.json();

        tasks =
            data.map(normalizeTask);

    }

    catch(error){

        console.warn(error);

        tasks = [];

        showToast(
            'No se pudieron cargar las tareas. Verifica conexión.',
            'error'
        );

    }

    renderTodayTasks();
    renderAllTasks();
    renderCalendar(calendarMonth, calendarYear);

}

async function createTask(payload){

    const response =
        await fetch(`${API_URL}/tasks`, {
            method: 'POST',
            headers: getAuthHeaders(),
            body: JSON.stringify(payload),
        });

    if(!response.ok){

        showToast(
            'No se pudo crear la tarea',
            'error'
        );

        throw new Error('No se pudo crear la tarea');

    }

    await fetchTasks();

}

async function updateTask(taskId, payload){

    const currentTask =
        tasks.find(task => task.id === Number(taskId));

    if(!currentTask) return;

    const response =
        await fetch(`${API_URL}/tasks/${taskId}`, {
            method: 'PUT',
            headers: getAuthHeaders(),
            body: JSON.stringify({
                ...currentTask,
                ...payload,
            }),
        });

    if(response.ok){

        await fetchTasks();

    } else {

        showToast(
            'Error al actualizar la tarea',
            'error'
        );

    }

}

async function deleteTask(taskId){

    const task =
        tasks.find(t => t.id === Number(taskId));

    if(!task) return;

    try{

        const response =
            await fetch(`${API_URL}/tasks/${taskId}`, {
                method: 'DELETE',
                headers: getAuthHeaders(),
            });

        if(response.ok){

            showUndoToast('Tarea eliminada', async () => {

                try{

                    await fetch(`${API_URL}/tasks`, {
                        method: 'POST',
                        headers: getAuthHeaders(),
                        body: JSON.stringify({
                            title: task.title,
                            due_date: task.due_date,
                            priority: task.priority,
                            duration_minutes: task.duration_minutes,
                            completed: task.completed,
                        }),
                    });

                    showToast('Tarea restaurada', 'success');

                    await fetchTasks();

                }

                catch(err){

                    showToast('No se pudo restaurar la tarea', 'error');

                }

            });

            await fetchTasks();

        } else {

            showToast('Error al eliminar la tarea', 'error');

        }

    }

    catch(error){

        showToast('Error de conexión al eliminar', 'error');

    }

}

function renderTaskList(container, taskItems){

    if(!container) return;

    container.innerHTML = '';

    taskItems.forEach(task => {

        container.appendChild(
            createTaskElement(task)
        );

    });

}

function renderTodayTasks(){

    const pendingTasks =
        tasks.filter(task => !task.completed);

    renderTaskList(
        todayTaskList,
        pendingTasks.slice(0, 5)
    );

    const pendingCount =
        pendingTasks.length;

    const todayCounter =
        document.querySelector('.tasks-title span');

    if(todayCounter){

        todayCounter.textContent =
            `${pendingCount} pendientes`;

    }

    updateBadgeCount();

}

function renderAllTasks(){

    renderTaskList(allTaskList, tasks);

    if(taskPageSummary){

        const pending =
            tasks.filter(task => !task.completed).length;

        taskPageSummary.textContent =
            `${tasks.length} tareas registradas • ${pending} pendientes`;

    }

    updateBadgeCount();

}

function getTasksByDate(dateString){

    return tasks.filter(task => task.due_date === dateString);

}

function renderSelectedDayTasks(dateString){

    const date =
        new Date(`${dateString}T00:00:00`);

    if(selectedDayTitle){

        selectedDayTitle.textContent =
            date.toLocaleDateString('es-CO', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
            });

    }

    renderTaskList(
        selectedDayTasks,
        getTasksByDate(dateString)
    );

}

/* =========================
   RENDER SESSIONS
========================= */

async function renderSessions(){

    const list =
        document.getElementById('sessionsList');

    if(!list) return;

    try{

        const response =
            await fetch(`${API_URL}/sessions`, {
                headers: getAuthHeaders(),
            });

        if(!response.ok) throw new Error();

        const sessions = await response.json();

        if(!sessions.length){

            list.innerHTML = `
                <div class="sessions-empty">
                    <i class="ri-timer-flash-line"></i>
                    <p>No hay sesiones registradas aún. Completa un Pomodoro para ver tu historial aquí.</p>
                </div>
            `;
            return;

        }

        list.innerHTML = '';

        sessions.forEach(s => {

            const date = new Date(s.created_at + 'Z');

            const dateStr =
                date.toLocaleDateString('es-CO', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                });

            const timeStr =
                date.toLocaleTimeString('es-CO', {
                    hour: '2-digit',
                    minute: '2-digit',
                });

            const modeLabel =
                s.mode === 'pomodoro' ? 'Enfoque'
                    : s.mode === 'long-break' ? 'Descanso largo'
                    : 'Descanso';

            const modeClass =
                s.mode === 'pomodoro' ? 'pomodoro'
                    : s.mode === 'long-break' ? 'long-break'
                    : 'break';

            const row =
                document.createElement('div');

            row.className = 'session-row';

            row.innerHTML = `
                <span class="session-date">${dateStr} · ${timeStr}</span>
                <span class="session-duration">${s.duration_minutes} min</span>
                <span class="session-mode ${modeClass}">${modeLabel}</span>
                <i class="ri-checkbox-circle-fill" style="color:#4cff88;font-size:18px;"></i>
            `;

            list.appendChild(row);

        });

    }

    catch(error){

        list.innerHTML = `
            <div class="sessions-empty">
                <i class="ri-cloud-off-line"></i>
                <p>No se pudieron cargar las sesiones. Verifica conexión con el backend.</p>
            </div>
        `;

    }

}

/* =========================
   UPDATE BADGE COUNT
========================= */

function updateBadgeCount(){

    const badge =
        document.getElementById('taskBadge');

    if(!badge) return;

    const pending =
        tasks.filter(t => !t.completed).length;

    badge.textContent = pending;

    badge.style.display =
        pending > 0 ? '' : 'none';

}

function renderCalendar(month, year){

    if(!calendarGrid || !calendarTitle) return;

    calendarGrid.innerHTML = '';

    const firstDay =
        new Date(year, month, 1);

    const firstWeekday =
        (firstDay.getDay() + 6) % 7;

    const calendarStart =
        new Date(year, month, 1 - firstWeekday);

    calendarTitle.textContent =
        firstDay.toLocaleDateString('es-CO', {
            month: 'long',
            year: 'numeric',
        });

    for(let index = 0; index < 42; index++){

        const day =
            new Date(calendarStart);

        day.setDate(calendarStart.getDate() + index);

        const dateString =
            formatDate(day);

        const dayTasks =
            getTasksByDate(dateString);

        const dayButton =
            document.createElement('button');

        dayButton.type = 'button';

        dayButton.className = 'calendar-day';

        dayButton.classList.toggle(
            'is-muted',
            day.getMonth() !== month
        );

        dayButton.classList.toggle(
            'is-today',
            dateString === formatDate(today)
        );

        dayButton.classList.toggle(
            'is-selected',
            dateString === selectedCalendarDate
        );

        dayButton.innerHTML = `
            <span class="calendar-day-number">${day.getDate()}</span>
            <span>
                ${dayTasks.slice(0, 3).map(() => '<i class="calendar-task-dot"></i>').join('')}
            </span>
            ${dayTasks[0] ? `<span class="calendar-task-preview">${dayTasks[0].title}</span>` : ''}
        `;

        dayButton.addEventListener('click', () => {

            selectedCalendarDate = dateString;

            renderCalendar(calendarMonth, calendarYear);

            renderSelectedDayTasks(dateString);

        });

        calendarGrid.appendChild(dayButton);

    }

    renderSelectedDayTasks(selectedCalendarDate);

}

if(taskForm){

    taskForm.addEventListener('submit', async event => {

        event.preventDefault();

        const title =
            document.getElementById('taskTitle').value.trim();

        if(!title) return;

        const submitBtn =
            taskForm.querySelector('.task-submit');

        const originalText =
            submitBtn.innerHTML;

        submitBtn.disabled = true;

        submitBtn.innerHTML = `
            <i class="ri-loader-4-line"></i>
            Creando...
        `;

        try{

            await createTask({
                title,
                due_date: document.getElementById('taskDate').value || formatDate(today),
                priority: document.getElementById('taskPriority').value,
                duration_minutes: Number(document.getElementById('taskDuration').value) || 30,
                completed: false,
            });

            taskForm.reset();

            document.getElementById('taskDuration').value = 30;

            submitBtn.disabled = false;

            submitBtn.innerHTML = originalText;

        }

        catch(error){

            submitBtn.disabled = false;

            submitBtn.innerHTML = originalText;

            showToast(
                'No se pudo crear la tarea. ¿El backend está activo?',
                'error'
            );

        }

    });

}

if(prevMonthBtn){

    prevMonthBtn.addEventListener('click', () => {

        calendarMonth--;

        if(calendarMonth < 0){

            calendarMonth = 11;
            calendarYear--;

        }

        renderCalendar(calendarMonth, calendarYear);

    });

}

if(nextMonthBtn){

    nextMonthBtn.addEventListener('click', () => {

        calendarMonth++;

        if(calendarMonth > 11){

            calendarMonth = 0;
            calendarYear++;

        }

        renderCalendar(calendarMonth, calendarYear);

    });

}

/* =========================
   CHART.JS
========================= */

const chartCanvas =
    document.getElementById('studyChart');

let studyChart = null;

if(chartCanvas && window.Chart){

    const ctxChart =
        chartCanvas.getContext('2d');

    studyChart = new Chart(ctxChart, {

        type: 'doughnut',

        data: {

            labels: [
                'Enfoque',
                'Descansos',
                'Estudio ligero',
                'Distracciones'
            ],

            datasets: [{

                data: [0, 0, 0, 0],

                backgroundColor: [
                    '#50e486',
                    '#7894ff',
                    '#ffad4c',
                    '#ff6b6b'
                ],

                borderColor: 'rgba(11,15,42,0.95)',

                borderWidth: 8,

                hoverOffset: 4,

                cutout: '72%',

            }]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            animation: {

                animateRotate: true,

                duration: 900

            },

            plugins: {

                legend: {

                    display: false

                }

            },
        }

    });

}

/* =========================
   LOAD USER INTO SIDEBAR
========================= */

function loadUserInSidebar(){

    const stored = localStorage.getItem('user');

    if(!stored) return;

    try{

        const userData = JSON.parse(stored);

        const name =
            userData.email.split('@')[0] || userData.email;

        const nameElement =
            document.querySelector('.user-info h3');

        const roleElement =
            document.querySelector('.user-info p');

        if(nameElement){

            nameElement.textContent = name;

        }

        if(roleElement){

            roleElement.textContent = userData.email;

        }

        const greetingName =
            document.getElementById('greetingName');

        if(greetingName){

            greetingName.textContent = name.charAt(0).toUpperCase() + name.slice(1);

        }

    }

    catch(e){

        console.warn('No se pudo cargar usuario en sidebar');

    }

}

/* =========================
   NOTIFICATION API
========================= */

function sendNotification(title, body){

    if(!('Notification' in window)) return;

    if(Notification.permission === 'granted'){

        new Notification(title, {
            body,
            icon: 'assets/imagenes/logo.png',
        });

    } else if(Notification.permission !== 'denied'){

        Notification.requestPermission();

    }

}

/* =========================
   KEYBOARD SHORTCUT (SPACE)
========================= */

document.addEventListener('keydown', (e) => {

    if(e.target.tagName === 'INPUT' ||
       e.target.tagName === 'TEXTAREA' ||
       e.target.tagName === 'SELECT') return;

    if(e.key === ' ' || e.code === 'Space'){

        e.preventDefault();

        if(timerRunning){

            pausePomodoro();

        } else {

            const btnText =
                startButton.textContent.trim();

            if(btnText === 'Iniciar sesión' ||
               btnText === 'Continuar'){

                startPomodoro();

            }

        }

    }

});

/* =========================
   PAUSE ON TAB HIDDEN
========================= */

document.addEventListener('visibilitychange', () => {

    if(document.hidden && timerRunning){

        pausePomodoro();

    }

});

/* =========================
   INITIALIZE
========================= */

updateTimer();

loadStats();

setBuddyMood('greeting');

loadStatsFromBackend();

loadUserInSidebar();

fetchTasks();
</file>

<file path="frontend/dashboard.css">
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:#0b0f2a;
    color:white;
    overflow-x:hidden;
    position:relative;
}

/* =========================
   APP LAYOUT
========================= */

.app-container{
    display:flex;
    min-height:100vh;
}

/* =========================
   SIDEBAR
========================= */

.sidebar{
    width:290px;
    background:rgba(10,15,35,0.95);
    border-right:1px solid rgba(255,255,255,0.05);
    padding:30px 20px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    backdrop-filter:blur(20px);
    transition:0.35s ease;
    flex-shrink:0;
    min-height:0;
    overflow-y:auto;
}

.sidebar::-webkit-scrollbar{
    width:4px;
}

.sidebar::-webkit-scrollbar-thumb{
    background:#7c5cff;
    border-radius:999px;
}

.sidebar > div:first-child{
    flex:1;
    min-height:0;
}

/* COLLAPSED */

.sidebar.collapsed{
    width:100px;
    padding:30px 15px;
}

.sidebar.collapsed .logo span,
.sidebar.collapsed .menu a span,
.sidebar.collapsed .user-info{
    opacity:0;
    visibility:hidden;
    width:0;
}

.sidebar.collapsed .logo,
.sidebar.collapsed .menu a,
.sidebar.collapsed .user-panel{
    justify-content:center;
}

.sidebar.collapsed .logout-btn{
    display:none;
}

.sidebar.collapsed .user-panel img{
    margin:0;
}

/* TOGGLE */

.sidebar-toggle{
    width:50px;
    height:50px;
    border:none;
    border-radius:16px;
    background:#171c45;
    color:white;
    font-size:22px;
    cursor:pointer;
    margin-bottom:25px;
    transition:0.3s;
}

.sidebar-toggle:hover{
    background:#7c5cff;
    transform:translateY(-2px);
    box-shadow:0 0 20px rgba(124,92,255,0.4);
}

/* LOGO */

.logo{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:28px;
    font-weight:700;
    margin-bottom:40px;
}

.logo i{
    color:#8b5cff;
}

.logo img{
    width:42px;
    height:42px;
    border-radius:12px;
    object-fit:cover;
    flex-shrink:0;
    filter:drop-shadow(0 0 16px rgba(124,92,255,0.35));
}

.logo span{
    background:linear-gradient(to right,#ffffff,#8b5cff);
    background-clip:text;
    -webkit-background-clip:text;
    color:transparent;
    -webkit-text-fill-color:transparent;
}

/* MENU */

.menu{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.menu a{
    display:flex;
    align-items:center;
    gap:14px;
    text-decoration:none;
    color:#cfcfff;
    padding:16px 18px;
    border-radius:18px;
    transition:0.3s;
    font-weight:500;
}

.menu a:hover{
    background:rgba(124,92,255,0.15);
    transform:translateX(5px);
}

.menu a.active{
    background:linear-gradient(135deg,#7c5cff,#9d7bff);
    color:white;
    box-shadow:0 0 25px rgba(124,92,255,0.45);
}

/* USER PANEL */

.user-panel{
    position:relative;
    display:flex;
    align-items:center;
    gap:15px;
    background:rgba(16,19,46,0.95);
    border:1px solid rgba(255,255,255,0.06);
    padding:18px;
    border-radius:24px;
    overflow:hidden;
    margin-top:30px;
    flex-shrink:0;
}

.user-panel img{
    width:60px;
    height:60px;
    border-radius:20px;
    object-fit:cover;
    border:2px solid rgba(124,92,255,0.4);
}

.user-info{
    flex:1;
}

.user-info h3{
    font-size:16px;
    margin-bottom:4px;
}

.user-info p{
    color:#a6abd3;
    font-size:14px;
}

.logout-btn{
    width:45px;
    height:45px;
    border:none;
    border-radius:16px;
    background:rgba(255,255,255,0.05);
    color:white;
    font-size:18px;
    cursor:pointer;
    transition:0.3s;
}

.logout-btn:hover{
    background:#7c5cff;
    transform:translateY(-2px);
}

.user-glow{
    position:absolute;
    width:120px;
    height:120px;
    background:#7c5cff;
    filter:blur(80px);
    opacity:0.18;
    right:-30px;
    bottom:-30px;
}

/* =========================
   MAIN CONTENT
========================= */

.main-content{
    flex:1;
    padding:35px;
    min-width:0;
}

/* TOPBAR */

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:30px;
    gap:20px;
    flex-wrap:wrap;
}

.welcome h1{
    font-size:42px;
}

.welcome p{
    color:#9ba1c7;
    margin-top:8px;
}

.topbar-actions{
    display:flex;
    align-items:center;
    gap:20px;
}

/* =========================
   INTERNAL SECTIONS
========================= */

.dashboard-section{
    display:none;
}

.dashboard-section.active{
    display:block;
}

.section-grid{
    display:grid;
    grid-template-columns:minmax(320px,0.8fr) minmax(0,1.2fr);
    gap:25px;
    align-items:start;
}

.placeholder-section-card{
    min-height:320px;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.placeholder-section-card p,
.task-create-card p,
.task-page-card p,
.calendar-header p{
    color:#a7add7;
    margin-top:8px;
    line-height:1.7;
}

/* =========================
   DASHBOARD GRID
========================= */

.dashboard-grid{
    display:grid;
    grid-template-columns:repeat(12, 1fr);
    gap:25px;
    align-items:start;
    grid-auto-rows:min-content;
}

.dashboard-grid > *{
    height:auto;
    align-self:start;
}

/* DISTRIBUCIÓN DE CARDS */
.focus-card{
    grid-column:1 / span 7;
    grid-row:1;
    height:fit-content;
}

.pet-card{
    grid-column:8 / span 5;
    grid-row:1;
}

.tasks-card{
    grid-column:1 / span 6;
    grid-row:2;
}

.productivity-card{
    grid-column:7 / span 6;
    grid-row:2;
}
/* =========================
   CARDS
========================= */
.card{
    background:rgba(16,19,46,0.92);
    overflow:hidden;
    border:1px solid rgba(255,255,255,0.06);
    border-radius:28px;
    padding:28px;
    backdrop-filter:blur(20px);
    box-shadow:0 10px 40px rgba(0,0,0,0.35);
    transition:0.35s ease;
}

.focus-card,
.pet-card,
.tasks-card,
.productivity-card{
    align-self:start;
}

.card.focus-card{
    background:transparent;
    backdrop-filter:none;
}

.card:hover{
    transform:translateY(-4px);
    box-shadow:0 20px 50px rgba(0,0,0,0.45);
}

.card-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
}

/* =========================
   PREMIUM FOCUS CARD
========================= */

.focus-card{
    --timer-size:280px;
    --circle-size:calc(var(--timer-size) * 0.80);

    /* Transparencia del fondo: 0 = se ve mucho la foto, 1 = casi no se ve */
    --focus-image-opacity:1;
    --focus-overlay-top:0.25;
    --focus-overlay-bottom:0.35;

    position:relative;
    overflow:hidden;
    isolation:isolate;
    background:transparent;

    display:flex;
    flex-direction:column;
    justify-content:flex-start;

    height:auto;
    padding-bottom:30px;
}

/* BACKGROUND */
.focus-bg{
    position:absolute;
    inset:0;
    background-image:url("./assets/imagenes/fondo_dashboard_morado.jpg");
    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
    opacity:var(--focus-image-opacity);
    z-index:0;
    pointer-events:none;
}

.focus-overlay{
    position:absolute;
    inset:0;
    z-index:1;
    background:
        linear-gradient(
            to top,
            rgba(5,8,20,var(--focus-overlay-top)),
            rgba(10,12,35,var(--focus-overlay-bottom))
        );
}

.focus-glow{
    position:absolute;
    width:500px;
    height:500px;
    background:#7c5cff;
    filter:blur(140px);
    opacity:.18;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    z-index:1;
}
.focus-content{
    position:relative;
    z-index:2;

    display:flex;
    flex-direction:column;

    gap:16px;
}

.focus-card > .focus-stars{
    position:relative;
    z-index:1;
}

.focus-subtitle{
    color:#a7add7;
    margin-top:8px;
}

.focus-actions{
    display:flex;
    align-items:center;
    gap:15px;
}

/* STATUS */

.status{
    display:flex;
    align-items:center;
    gap:8px;
    background:#1a1f4d;
    padding:10px 14px;
    border-radius:12px;
    white-space:nowrap;
}

.status span{
    width:10px;
    height:10px;
    border-radius:50%;
    background:#4cff88;
}

/* MUSIC BUTTON */

.music-btn{
    width:54px;
    height:54px;
    border:none;
    border-radius:18px;
    background:rgba(255,255,255,.05);
    color:#b892ff;
    font-size:22px;
    cursor:pointer;
    backdrop-filter:blur(10px);
    border:1px solid rgba(255,255,255,.05);
    transition:0.3s;
}

.music-btn:hover{
    transform:translateY(-3px);
    background:#7c5cff;
    color:white;
    box-shadow:0 0 25px rgba(124,92,255,.45);
}

/* =========================
   TIMER
========================= */

.focus-circle{
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    margin:0;
    gap:16px;
}

.timer-ring{
    position:relative;
    width:var(--timer-size);
    height:var(--timer-size);
    flex-shrink:0;
    overflow:visible;
    background:transparent;
    border:none;
}

.progress-ring{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    display:block;
    overflow:visible;
    transform:rotate(-90deg);
    pointer-events:none;
}

.progress-bg{
    fill:transparent;
    stroke:rgba(255,255,255,.06);
    stroke-width:12;
}

.progress-ring-circle{
    fill:transparent;
    stroke:url(#gradientStroke);
    stroke-width:12;
    stroke-linecap:round;
    transition:stroke-dashoffset 1s linear;
    filter:drop-shadow(0 0 14px rgba(124,92,255,.8));
}

.circle{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    width:var(--circle-size);
    height:var(--circle-size);
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    padding:14px;
    border-radius:50%;
    background:
        radial-gradient(
            circle at top,
            rgba(124,92,255,.12),
            rgba(15,18,45,.98)
        );
    border:1px solid rgba(255,255,255,0.06);
    box-shadow:
        0 0 40px rgba(124,92,255,.18),
        inset 0 0 40px rgba(255,255,255,.03);
    z-index:1;
}

.circle.running{
    animation:pulseTimer 2s infinite;
}

@keyframes pulseTimer{
    0%{
        transform:translate(-50%,-50%) scale(1);
    }

    50%{
        transform:translate(-50%,-50%) scale(1.03);
    }

    100%{
        transform:translate(-50%,-50%) scale(1);
    }
}

.focus-mode-label{
    font-size:16px;
    font-weight:600;
    letter-spacing:0.02em;
    margin-bottom:10px;
}

.circle h1{
    font-size:clamp(32px,8vw,44px);
    font-weight:700;
    letter-spacing:-3px;
    margin:0;
    line-height:1;
}

.circle p{
    color:#9fa5d1;
    margin:8px 0 12px 0;
    font-size:12px;
}

/* BUTTONS */

button{
    transition:0.3s ease;
}

button:hover{
    transform:translateY(-2px);
}

.primary-btn{
    border:none;
    background:linear-gradient(135deg,#7c5cff,#9d7bff);
    color:white;
    padding:10px 14px;
    border-radius:12px;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    box-shadow:0 0 20px rgba(124,92,255,.35);
    min-width:120px;
    text-align:center;
    margin:0;
}

.circle .primary-btn,
#startBtn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    padding:12px 24px;
    font-size:16px;
    white-space:nowrap;
    min-width:max-content;
    border-radius:14px;
}

.timer-buttons{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:10px;
}

.secondary-btn{
    width:38px;
    height:38px;
    border:none;
    border-radius:12px;
    background:rgba(23,28,69,0.8);
    color:#b892ff;
    font-size:16px;
    cursor:pointer;
    transition:0.3s;
    display:flex;
    justify-content:center;
    align-items:center;
    border:1px solid rgba(124,92,255,0.2);
}

.timer-buttons .secondary-btn{
    width:48px;
    height:48px;
    font-size:20px;
    border-radius:14px;
}

.secondary-btn:hover{
    background:#7c5cff;
    box-shadow:0 0 20px rgba(124,92,255,0.4);
}

/* SESSION FLOW */

.session-flow{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:12px;
    margin-top:10px;
    flex-wrap:wrap;
}

.flow-card{
    min-width:140px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    padding:18px 22px;
    border-radius:22px;
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.05);
    backdrop-filter:blur(10px);
    color:#d7daf7;
    cursor:pointer;
    transition:0.3s;
}

.flow-card:hover{
    transform:translateY(-2px);
    background:rgba(255,255,255,.08);
}

.flow-card:focus-visible{
    outline:2px solid #7c5cff;
    outline-offset:2px;
}

.flow-card.active{
    background:
        linear-gradient(
            135deg,
            rgba(124,92,255,.18),
            rgba(124,92,255,.08)
        );
    border:1px solid rgba(124,92,255,.35);
    box-shadow:0 0 25px rgba(124,92,255,.2);
}

.flow-card small{
    color:#9ca3cf;
}

.flow-arrow{
    color:#7c5cff;
    font-size:28px;
}

/* =========================
   MINI STREAK
========================= */

.mini-streak{
    display:flex;
    align-items:center;
    gap:22px;
    background:rgba(16,19,46,0.9);
    border:1px solid rgba(255,255,255,0.06);
    padding:14px 18px;
    border-radius:22px;
    backdrop-filter:blur(20px);
    box-shadow:0 10px 30px rgba(0,0,0,0.3);
}

.mini-streak-summary{
    display:flex;
    align-items:center;
    gap:12px;
    padding-right:20px;
    border-right:1px solid rgba(255,255,255,0.07);
}

.mini-fire{
    font-size:34px;
    filter:drop-shadow(0 0 16px rgba(255,117,76,0.4));
}

.mini-streak-summary span,
.mini-streak-summary small{
    display:block;
    color:#aeb3d8;
    font-size:12px;
}

.mini-streak-summary strong{
    display:block;
    color:#ff8a4c;
    font-size:24px;
    line-height:1.1;
    margin:3px 0;
}

.mini-days{
    display:flex;
    gap:14px;
}

.mini-day{
    width:38px;
    min-height:52px;
    border-radius:14px;
    background:transparent;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    align-items:center;
    gap:6px;
    font-size:12px;
    font-weight:600;
    color:#9da3cf;
}

.mini-day span{
    color:#cfd2ec;
    font-size:12px;
}

.mini-day i{
    width:26px;
    height:26px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    font-size:17px;
    border:2px solid rgba(255,255,255,0.12);
}

.mini-day.active{
    color:#5cff9b;
}

.mini-day.active i{
    border-color:#21d981;
    color:#21d981;
    box-shadow:0 0 16px rgba(33,217,129,0.25);
}

.mini-day.current{
    color:white;
}

.mini-day.current i{
    border-color:#21d981;
    color:#21d981;
    background:rgba(33,217,129,0.08);
}

.mini-day.pending i{
    border-color:#ff8a4c;
    box-shadow:0 0 14px rgba(255,138,76,0.18);
}

/* =========================
   TASKS
========================= */

.task-list{
    margin-top:25px;
    display:flex;
    flex-direction:column;
    gap:10px;
}

.task-list:empty::before{
    content:"No hay tareas para mostrar.";
    display:block;
    padding:18px;
    border:1px dashed rgba(124,92,255,0.28);
    border-radius:14px;
    color:#9ea4cf;
    text-align:center;
    background:rgba(255,255,255,0.03);
}

.tasks-title{
    display:flex;
    align-items:center;
    gap:14px;
}

.tasks-title span{
    padding:6px 12px;
    border-radius:999px;
    background:rgba(255,255,255,0.05);
    color:#b9bee0;
    font-size:13px;
    font-weight:500;
}

.task{
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(13,18,45,0.68);
    border:1px solid rgba(255,255,255,0.06);
    padding:12px;
    border-radius:14px;
    gap:12px;
    transition:0.25s ease;
}

.task:hover{
    background:rgba(18,24,58,0.88);
    border-color:rgba(124,92,255,0.22);
}

.task-left{
    display:flex;
    align-items:center;
    gap:14px;
    min-width:0;
}

.task-left input{
    width:20px;
    height:20px;
    accent-color:#7c5cff;
    flex-shrink:0;
}

.task-left > span{
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    min-width:0;
}

.task-icon{
    width:28px;
    height:28px;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:white;
    flex-shrink:0;
}

.task-icon.purple{
    background:linear-gradient(135deg,#7c5cff,#9d7bff);
}

.task-icon.orange{
    background:linear-gradient(135deg,#ffb84d,#ff8a4c);
}

.task-icon.blue{
    background:linear-gradient(135deg,#5d7cff,#6fa8ff);
}

.task-meta{
    display:flex;
    align-items:center;
    gap:14px;
    flex-shrink:0;
}

.task-meta small{
    color:#aeb3d8;
    min-width:48px;
    text-align:right;
}

.task-menu{
    width:28px;
    height:28px;
    border:none;
    border-radius:8px;
    background:transparent;
    color:#ef4444;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:0.25s ease;
}

.task-menu:hover{
    color:#ff6b6b;
    background:rgba(255,107,107,0.12);
}

.task.completed .task-left > span{
    color:#8288b5;
    text-decoration:line-through;
}

.task-form{
    margin-top:24px;
    display:flex;
    flex-direction:column;
    gap:16px;
}

.task-form label{
    display:flex;
    flex-direction:column;
    gap:8px;
    color:#d8daf0;
    font-size:14px;
    font-weight:500;
}

.task-form input,
.task-form select{
    width:100%;
    border:1px solid rgba(255,255,255,0.08);
    border-radius:14px;
    background:rgba(10,15,35,0.72);
    color:white;
    padding:13px 14px;
    font:inherit;
    outline:none;
}

.task-form input:focus,
.task-form select:focus{
    border-color:rgba(124,92,255,0.55);
    box-shadow:0 0 0 4px rgba(124,92,255,0.12);
}

.form-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.task-submit{
    width:fit-content;
}

.badge{
    padding:5px 12px;
    border-radius:8px;
    font-size:12px;
    font-weight:600;
}

.high{
    background:rgba(255,95,95,0.2);
    color:#ff6b6b;
}

.medium{
    background:rgba(255,184,77,0.2);
    color:#ffb84d;
}

.low{
    background:rgba(92,255,155,0.2);
    color:#5cff9b;
}

.small-btn{
    border:none;
    display:flex;
    align-items:center;
    gap:6px;
    background:transparent;
    color:white;
    padding:10px 16px;
    border-radius:12px;
    cursor:pointer;
    color:#9d7bff;
    font-weight:600;
}

/* =========================
   PET CARD
========================= */

.pet-card{
    position:relative;
    overflow:hidden;
    min-width:0;
    min-height:430px;
}

.pet-card::before{
    content:"";
    position:absolute;
    width:260px;
    height:260px;
    right:-70px;
    top:-80px;
    background:#7c5cff;
    filter:blur(130px);
    opacity:0.15;
    pointer-events:none;
}

.pet-header{
    position:relative;
    z-index:1;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
}

.pet-header h2 span{
    color:#b47cff;
}

.pet-header p{
    color:#a9aed4;
}

.xp{
    color:#d6d8f3;
    font-size:14px;
}

.xp-bar{
    position:relative;
    z-index:1;
    width:100%;
    height:10px;
    background:#1b204b;
    border-radius:999px;
    margin:16px 0 16px;
    overflow:hidden;
}

.xp-fill{
    width:70%;
    height:100%;
    background:linear-gradient(90deg,#7c5cff,#b28cff);
    border-radius:999px;
    box-shadow:0 0 20px rgba(124,92,255,0.5);
    transition:width .6s ease;
}

.pet-content{
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(130px,0.9fr);
    align-items:center;
    gap:16px;
    min-width:0;
}

.pet-message{
    position:relative;
    z-index:2;
    width:100%;
    background:linear-gradient(135deg,rgba(255,255,255,0.08),rgba(255,255,255,0.03));
    border:1px solid rgba(255,255,255,0.06);
    padding:20px 22px;
    border-radius:18px;
    max-width:280px;
    min-width:0;
    box-shadow:0 18px 40px rgba(0,0,0,0.18);
    overflow-wrap:break-word;
    word-break:normal;
}

.pet-message::after{
    content:"";
    position:absolute;
    right:-9px;
    top:46px;
    width:18px;
    height:18px;
    background:rgba(255,255,255,0.055);
    border-top:1px solid rgba(255,255,255,0.06);
    border-right:1px solid rgba(255,255,255,0.06);
    transform:rotate(45deg);
}

.pet-message p{
    margin-top:10px;
    line-height:1.7;
    color:#b8bcde;
    overflow-wrap:break-word;
    word-break:normal;
}

.pet-message h3{
    overflow-wrap:break-word;
    word-break:normal;
}

.pet-mascot-slot{
    position:relative;
    width:auto;
    min-width:0;
    min-height:clamp(230px,22vw,310px);
    display:flex;
    align-items:center;
    justify-content:flex-end;
    flex-shrink:0;
    overflow:visible;
}

.pet-mascot-slot::before{
    content:"";
    position:absolute;
    width:min(96%,190px);
    aspect-ratio:1;
    height:auto;
    border-radius:50%;
    background:radial-gradient(circle,rgba(124,92,255,0.22),rgba(124,92,255,0));
    filter:blur(8px);
}

.pet-mascot-placeholder{
    position:relative;
    z-index:1;
    width:min(100%,190px);
    aspect-ratio:1;
    height:auto;
    min-width:128px;
    border-radius:32px;
    border:1px dashed rgba(180,124,255,0.5);
    background:
        linear-gradient(135deg,rgba(124,92,255,0.12),rgba(255,255,255,0.03));
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:10px;
    color:#9fa5d1;
    font-size:13px;
    text-align:center;
    padding:16px;
    line-height:1.4;
}

.pet-mascot-placeholder i{
    font-size:42px;
    color:#7c5cff;
    opacity:0.85;
    filter:drop-shadow(0 0 16px rgba(124,92,255,0.35));
}

.pet-mascot-placeholder small{
    color:#787fa9;
    font-size:11px;
}

.pet-content img.pet-mascot-img{
    width:auto;
    height:auto;
    max-width:100%;
    max-height:clamp(250px,24vw,360px);
    object-fit:contain;
    animation:floatPet 4s ease-in-out infinite;
}

.pet-content img.pet-mascot-img.is-hidden{
    display:none;
}

@keyframes floatPet{
    0%{
        transform:translateY(0px);
    }

    50%{
        transform:translateY(-10px);
    }

    100%{
        transform:translateY(0px);
    }
}

.mood-card{
    position:relative;
    z-index:1;
    margin-top:8px;
    display:flex;
    align-items:center;
    gap:15px;
    background:rgba(255,255,255,0.04);
    padding:18px;
    border-radius:18px;
}

.mood-icon{
    width:46px;
    height:46px;
    border-radius:15px;
    background:rgba(92,255,155,0.15);
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:24px;
    color:#39d98a;
}

.mood-card p{
    color:#aeb3d8;
    font-size:13px;
    margin-top:3px;
}

/* =========================
   PRODUCTIVITY CARD
========================= */

.productivity-card{
    position:relative;
    overflow:hidden;
    margin-top: 0;
}

.productivity-card::before{
    content:"";
    position:absolute;
    width:200px;
    height:200px;
    background:#7c5cff;
    filter:blur(120px);
    opacity:0.12;
    top:-80px;
    right:-80px;
}

.productivity-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:24px;
    position:relative;
    z-index:1;
}

.productivity-header p{
    color:#9ea4cf;
    margin-top:5px;
}

.period-btn{
    border:none;
    display:flex;
    align-items:center;
    gap:8px;
    color:#d6d8f3;
    background:rgba(255,255,255,0.05);
    border:1px solid rgba(255,255,255,0.05);
    padding:10px 14px;
    border-radius:12px;
    cursor:pointer;
}

.productivity-overview{
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:190px 1fr;
    align-items:center;
    gap:28px;
}

.productivity-donut{
    position:relative;
    width:180px;
    height:180px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.productivity-donut canvas{
    width:180px !important;
    height:180px !important;
}

.productivity-score{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    display:flex;
    justify-content:center;
    align-items:center;
    pointer-events:none;
}

.productivity-score strong{
    font-size:34px;
    line-height:1;
}

.productivity-score span{
    color:#aeb3d8;
    font-size:13px;
    margin-top:8px;
}

/* PROGRESS */

.productivity-progress{
    display:flex;
    flex-direction:column;
    gap:14px;
}

.progress-item{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.progress-info{
    display:flex;
    justify-content:space-between;
    gap:12px;
    color:#d8daf0;
    font-size:14px;
}

.progress-info span{
    display:flex;
    align-items:center;
    gap:8px;
}

.legend-dot{
    width:10px;
    height:10px;
    border-radius:50%;
    display:inline-flex;
    flex-shrink:0;
}

.legend-dot.green{
    background:#50e486;
}

.legend-dot.blue{
    background:#7894ff;
}

.legend-dot.orange{
    background:#ffad4c;
}

.legend-dot.red{
    background:#ff6b6b;
}

.progress-bar{
    width:100%;
    height:8px;
    background:#1a1f4d;
    border-radius:999px;
    overflow:hidden;
}

.progress-fill{
    height:100%;
    border-radius:999px;
}

.progress-fill.purple{
    width:92%;
    background:linear-gradient(90deg,#7c5cff,#b28cff);
}

.progress-fill.green{
    width:76%;
    background:linear-gradient(90deg,#43e97b,#38f9d7);
}

.progress-fill.blue{
    width:62%;
    background:linear-gradient(90deg,#7894ff,#8fb7ff);
}

.progress-fill.orange{
    width:68%;
    background:linear-gradient(90deg,#ff9966,#ff5e62);
}

.progress-fill.red{
    width:36%;
    background:linear-gradient(90deg,#ff6b6b,#ff8a7a);
}

.productivity-insight{
    position:relative;
    z-index:1;
    margin-top:24px;
    display:grid;
    grid-template-columns:auto minmax(0,1fr) auto;
    align-items:center;
    gap:16px;
    padding:18px;
    border-radius:18px;
    background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.06);
}

.insight-icon{
    width:42px;
    height:42px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(157,123,255,0.16);
    color:#b47cff;
    font-size:24px;
    flex-shrink:0;
}

.productivity-insight h4{
    color:#d18cff;
    font-size:14px;
    margin-bottom:6px;
}

.productivity-insight p{
    color:#aeb3d8;
    font-size:13px;
    line-height:1.6;
}

/* =========================
   CALENDAR
========================= */

.calendar-card{
    position:relative;
}

.calendar-header{
    display:flex;
    justify-content:space-between;
    gap:20px;
    align-items:center;
    margin-bottom:26px;
}

.calendar-controls{
    display:flex;
    gap:10px;
}

.calendar-layout{
    display:grid;
    grid-template-columns:minmax(0,1fr) 320px;
    gap:24px;
    align-items:start;
}

.calendar-board{
    min-width:0;
}

.calendar-weekdays,
.calendar-grid{
    display:grid;
    grid-template-columns:repeat(7, minmax(0,1fr));
    gap:10px;
}

.calendar-weekdays{
    margin-bottom:10px;
}

.calendar-weekdays span{
    color:#9ea4cf;
    font-size:13px;
    text-align:center;
    font-weight:600;
}

.calendar-day{
    min-height:112px;
    border:none;
    border-radius:18px;
    background:rgba(13,18,45,0.68);
    border:1px solid rgba(255,255,255,0.06);
    color:white;
    padding:12px;
    text-align:left;
    cursor:pointer;
    display:flex;
    flex-direction:column;
    gap:8px;
    overflow:hidden;
}

.calendar-day:hover{
    background:rgba(18,24,58,0.9);
    border-color:rgba(124,92,255,0.28);
}

.calendar-day.is-muted{
    opacity:.38;
}

.calendar-day.is-today{
    box-shadow:inset 0 0 0 1px rgba(92,255,155,0.38);
}

.calendar-day.is-selected{
    border-color:rgba(124,92,255,0.72);
    box-shadow:0 0 24px rgba(124,92,255,0.22);
}

.calendar-day-number{
    font-weight:700;
}

.calendar-task-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    display:inline-flex;
    background:#7c5cff;
    box-shadow:0 0 12px rgba(124,92,255,0.5);
}

.calendar-task-preview{
    color:#cfd2ec;
    font-size:12px;
    line-height:1.4;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.calendar-day-panel{
    background:rgba(255,255,255,0.035);
    border:1px solid rgba(255,255,255,0.06);
    border-radius:22px;
    padding:20px;
}

.calendar-day-panel h3{
    margin-bottom:18px;
}

.task-list.compact{
    margin-top:0;
}

.task-list.compact .task{
    flex-direction:column;
    align-items:flex-start;
}

.calendar-day-panel .task-left > span{
    white-space:normal;
    text-overflow:clip;
    overflow-wrap:break-word;
    word-break:break-word;
}

.insight-bars{
    display:flex;
    align-items:flex-end;
    gap:6px;
    height:82px;
    padding:0 2px 2px;
    align-self:end;
}

.insight-bars span{
    width:9px;
    height:var(--bar-height);
    border-radius:999px 999px 4px 4px;
    background:linear-gradient(180deg,#d18cff 0%,#7c5cff 58%,rgba(124,92,255,0.28) 100%);
    box-shadow:0 0 18px rgba(157,123,255,0.45);
    transform-origin:bottom;
    animation:insightBarPulse 2.4s ease-in-out infinite;
    animation-delay:var(--delay);
}

@keyframes insightBarPulse{
    0%,
    100%{
        transform:scaleY(.72);
        opacity:.72;
    }

    50%{
        transform:scaleY(1);
        opacity:1;
    }
}

/* MINI STATS */

.mini-stats{
    margin-top:35px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.mini-stat{
    background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.05);
    padding:20px;
    border-radius:20px;
    text-align:center;
}

.mini-stat h3{
    font-size:26px;
    margin-bottom:8px;
}

.mini-stat p{
    color:#9ea4cf;
    font-size:13px;
}

/* =========================
   BACKGROUND BLOBS
========================= */

.background-blobs{
    position:fixed;
    inset:0;
    overflow:hidden;
    z-index:-2;
    pointer-events:none;
}

.blob{
    position:absolute;
    border-radius:50%;
    filter:blur(120px);
    opacity:0.18;
    animation:floatBlob 18s infinite ease-in-out;
}

.blob1{
    width:420px;
    height:420px;
    background:#7c5cff;
    top:-120px;
    left:-120px;
}

.blob2{
    width:350px;
    height:350px;
    background:#4d8dff;
    bottom:-100px;
    right:-80px;
    animation-delay:4s;
}

.blob3{
    width:300px;
    height:300px;
    background:#a855f7;
    top:40%;
    left:45%;
    animation-delay:2s;
}

@keyframes floatBlob{
    0%{
        transform:translate(0px,0px) scale(1);
    }

    25%{
        transform:translate(40px,-30px) scale(1.05);
    }

    50%{
        transform:translate(-20px,40px) scale(0.95);
    }

    75%{
        transform:translate(30px,20px) scale(1.03);
    }

    100%{
        transform:translate(0px,0px) scale(1);
    }
}

/* PARTICLES */

#particles{
    position:fixed;
    inset:0;
    width:100%;
    height:100%;
    z-index:-1;
    pointer-events:none;
}

/* STARS */

.focus-stars span{
    position:absolute;
    width:4px;
    height:4px;
    border-radius:50%;
    background:#caa8ff;
    box-shadow:0 0 10px #caa8ff;
    animation:twinkle 4s infinite ease-in-out;
}

.focus-stars span:nth-child(1){
    top:20%;
    left:15%;
}

.focus-stars span:nth-child(2){
    top:30%;
    right:18%;
    animation-delay:1s;
}

.focus-stars span:nth-child(3){
    top:60%;
    left:20%;
    animation-delay:2s;
}

.focus-stars span:nth-child(4){
    top:75%;
    right:22%;
    animation-delay:3s;
}

.focus-stars span:nth-child(5){
    top:45%;
    left:50%;
    animation-delay:1.5s;
}

@keyframes twinkle{
    0%{
        opacity:.2;
        transform:scale(.8);
    }

    50%{
        opacity:1;
        transform:scale(1.8);
    }

    100%{
        opacity:.2;
        transform:scale(.8);
    }
}

/* =========================
   SCROLLBAR
========================= */

::-webkit-scrollbar{
    width:10px;
}

::-webkit-scrollbar-track{
    background:#0f1333;
}

::-webkit-scrollbar-thumb{
    background:#7c5cff;
    border-radius:999px;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:1200px){

    .dashboard-grid{
        grid-template-columns:1fr;
    }

    .section-grid,
    .calendar-layout{
        grid-template-columns:1fr;
    }

    .focus-card,
    .pet-card,
    .tasks-card,
    .productivity-card{
        grid-column:auto;
        grid-row:auto;
    }

    .pet-content{
        grid-template-columns:minmax(220px,0.82fr) minmax(220px,1fr);
        justify-content:center;
    }

}

@media(max-width:1050px) and (min-width:901px){

    .pet-card{
        min-height:auto;
    }

    .pet-message{
        max-width:320px;
    }

    .pet-mascot-slot{
        min-height:clamp(220px,28vw,300px);
    }

    .pet-content img.pet-mascot-img{
        max-height:clamp(240px,30vw,340px);
    }

}

@media(max-width:900px){

    .sidebar{
        display:none;
    }

    .main-content{
        padding:20px;
    }

    .welcome h1{
        font-size:32px;
    }

    .focus-card{
        --timer-size:240px;
    }

    .pet-content{
        grid-template-columns:1fr;
        align-items:center;
        text-align:center;
    }

    .pet-message{
        max-width:100%;
    }

    .pet-mascot-slot{
        width:100%;
        min-height:clamp(160px,48vw,250px);
        justify-content:center;
    }

    .pet-message::after{
        display:none;
    }

    .productivity-overview{
        grid-template-columns:1fr;
        justify-items:center;
    }

    .productivity-progress{
        width:100%;
    }

    .productivity-insight{
        grid-template-columns:auto minmax(0,1fr);
    }

    .insight-bars{
        grid-column:1 / -1;
        justify-self:end;
        height:64px;
    }

    .mini-stats{
        grid-template-columns:1fr;
    }

}

@media(max-width:600px){

    .topbar{
        flex-direction:column;
        align-items:flex-start;
    }

    .mini-streak{
        width:100%;
        overflow-x:auto;
    }

    .mini-streak-summary{
        min-width:145px;
    }

    .card-header,
    .productivity-header,
    .pet-header,
    .calendar-header{
        align-items:flex-start;
        flex-direction:column;
    }

    .form-row{
        grid-template-columns:1fr;
    }

    .calendar-weekdays,
    .calendar-grid{
        gap:6px;
    }

    .calendar-day{
        min-height:82px;
        padding:9px;
        border-radius:14px;
    }

    .calendar-task-preview{
        display:none;
    }

    .tasks-title{
        flex-wrap:wrap;
    }

    .task{
        align-items:flex-start;
        flex-direction:column;
    }

    .task-left{
        width:100%;
    }

    .task-meta{
        width:100%;
        justify-content:space-between;
    }

    .session-flow{
        flex-direction:column;
    }

    .flow-arrow{
        transform:rotate(90deg);
    }

    .card{
        padding:22px;
    }

}

canvas{
    max-width:100%;
}

img{
    max-width:100%;
    display:block;
}

/* =========================
   TOAST
========================= */

.toast-container{
    position:fixed;
    bottom:30px;
    right:30px;
    z-index:9999;
    display:flex;
    flex-direction:column;
    gap:10px;
    pointer-events:none;
}

.toast{
    pointer-events:auto;
    padding:16px 24px;
    border-radius:16px;
    background:rgba(16,19,46,0.96);
    border:1px solid rgba(255,255,255,0.08);
    backdrop-filter:blur(20px);
    box-shadow:0 10px 40px rgba(0,0,0,0.5);
    display:flex;
    align-items:center;
    gap:12px;
    font-size:14px;
    color:white;
    animation:toastIn 0.35s ease, toastOut 0.35s ease 3.65s forwards;
    max-width:380px;
}

.toast i{
    font-size:20px;
    flex-shrink:0;
}

.toast.success i{color:#4cff88;}
.toast.info i{color:#7c5cff;}
.toast.warning i{color:#ffad4c;}
.toast.error i{color:#ff6b6b;}

@keyframes toastIn{
    from{
        opacity:0;
        transform:translateX(40px) scale(0.92);
    }
    to{
        opacity:1;
        transform:translateX(0) scale(1);
    }
}

@keyframes toastOut{
    from{
        opacity:1;
        transform:translateX(0) scale(1);
    }
    to{
        opacity:0;
        transform:translateX(40px) scale(0.92);
    }
}

/* =========================
   SKELETON LOADING
========================= */

.skeleton{
    background:linear-gradient(
        90deg,
        rgba(255,255,255,0.03) 25%,
        rgba(255,255,255,0.08) 50%,
        rgba(255,255,255,0.03) 75%
    );
    background-size:200% 100%;
    animation:skeleton-loading 1.5s ease infinite;
    border-radius:10px;
}

@keyframes skeleton-loading{
    0%{background-position:200% 0;}
    100%{background-position:-200% 0;}
}

.skeleton-task{
    height:52px;
    margin-bottom:10px;
}

/* =========================
   SIDEBAR COLLAPSED TOOLTIPS
========================= */

.sidebar.collapsed .menu a{
    position:relative;
}

.sidebar.collapsed .menu a:hover::after{
    content:attr(data-tip);
    position:fixed;
    left:85px;
    background:rgba(16,19,46,0.96);
    color:white;
    padding:8px 14px;
    border-radius:12px;
    font-size:13px;
    white-space:nowrap;
    z-index:1000;
    border:1px solid rgba(255,255,255,0.08);
    box-shadow:0 8px 24px rgba(0,0,0,0.5);
    pointer-events:none;
}

/* =========================
   MENU BADGE
========================= */

.menu-badge{
    margin-left:auto;
    background:#7c5cff;
    color:white;
    font-size:11px;
    font-weight:700;
    padding:2px 9px;
    border-radius:999px;
    min-width:20px;
    text-align:center;
    line-height:1.6;
}

.sidebar.collapsed .menu-badge{
    display:none;
}

/* =========================
   SESSIONS TABLE
========================= */

.sessions-list{
    display:flex;
    flex-direction:column;
    gap:8px;
    margin-top:20px;
}

.session-row{
    display:grid;
    grid-template-columns:2fr 1fr 1fr auto;
    align-items:center;
    gap:16px;
    background:rgba(13,18,45,0.68);
    border:1px solid rgba(255,255,255,0.06);
    padding:14px 18px;
    border-radius:14px;
    transition:0.25s ease;
}

.session-row:hover{
    background:rgba(18,24,58,0.88);
    border-color:rgba(124,92,255,0.22);
}

.session-date{
    color:#cfd2ec;
    font-size:14px;
}

.session-duration{
    color:#5cff9b;
    font-weight:600;
    font-size:14px;
}

.session-mode{
    padding:4px 12px;
    border-radius:8px;
    font-size:12px;
    font-weight:600;
    text-align:center;
}

.session-mode.pomodoro{
    background:rgba(124,92,255,0.2);
    color:#b47cff;
}

.session-mode.break{
    background:rgba(255,184,77,0.2);
    color:#ffb84d;
}

.session-mode.long-break{
    background:rgba(92,255,155,0.2);
    color:#5cff9b;
}

.sessions-empty{
    text-align:center;
    padding:40px 20px;
    color:#9ea4cf;
}

.sessions-empty i{
    font-size:48px;
    color:#7c5cff;
    opacity:0.5;
    margin-bottom:16px;
    display:block;
}

/* =========================
   TOAST UNDO BUTTON
========================= */

.toast-undo{
    background:rgba(124,92,255,0.2);
    border:1px solid rgba(124,92,255,0.3);
    color:#b47cff;
    padding:6px 14px;
    border-radius:10px;
    cursor:pointer;
    font-weight:600;
    font-size:13px;
    margin-left:10px;
    flex-shrink:0;
    transition:0.2s;
}

.toast-undo:hover{
    background:rgba(124,92,255,0.35);
    transform:translateY(-1px);
}

.toast.has-undo{
    padding-right:14px;
}
