                    <!-- MINI STATS -->
                    <div class="mini-stats">

                        <div class="mini-stat">

                            <h3 id="studyHours">0h</h3>
                            <p>Tiempo total</p>

                        </div>

                        <div class="mini-stat">

                            <h3 id="sessionsCount">0</h3>
                            <p>Sesiones</p>

                        </div>

                        <div class="mini-stat">

                            <h3 id="consistency">100%</h3>
                            <p>Consistencia</p>

                        </div>

                    </div>

                </div>

            </section>

            </section>

            <section class="dashboard-section" id="section-tasks">

                <div class="section-grid">

                    <div class="card task-create-card">

                        <div class="card-header">

                            <div>

                                <h2>Crear nueva tarea</h2>
                                <p>Organiza tus entregas y sesiones desde un solo lugar.</p>

                            </div>

                        </div>

                        <form class="task-form" id="taskForm">

                            <label>
                                Tarea
                                <input type="text" id="taskTitle" placeholder="Ej: Repasar estructuras de datos" required>
                            </label>

                            <div class="form-row">

                                <label>
                                    Fecha
                                    <input type="date" id="taskDate">
                                </label>

                                <label>
                                    Prioridad
                                    <select id="taskPriority">
                                        <option value="alta">Alta</option>
                                        <option value="media" selected>Media</option>
                                        <option value="baja">Baja</option>
                                    </select>
                                </label>

                            </div>

                            <label>
                                Duración estimada
                                <input type="number" id="taskDuration" min="5" step="5" value="30">
                            </label>

                            <button class="primary-btn task-submit" type="submit">
                                <i class="ri-add-line"></i>
                                Crear tarea
                            </button>

                        </form>

                    </div>

                    <div class="card task-page-card">

                        <div class="card-header">

                            <div>

                                <h2>Todas las tareas</h2>
                                <p id="taskPageSummary">Cargando tareas...</p>

                            </div>

                        </div>

                        <div class="task-list" id="allTaskList"></div>

                    </div>

                </div>

            </section>

            <section class="dashboard-section" id="section-calendar">

                <div class="card calendar-card">

                    <div class="calendar-header">

                        <div>

                            <h2 id="calendarTitle">Calendario</h2>
                            <p>Visualiza tus tareas por fecha y mantén claridad semanal.</p>

                        </div>

                        <div class="calendar-controls">

                            <button class="secondary-btn" id="prevMonthBtn" title="Mes anterior">
                                <i class="ri-arrow-left-s-line"></i>
                            </button>

                            <button class="secondary-btn" id="nextMonthBtn" title="Mes siguiente">
                                <i class="ri-arrow-right-s-line"></i>
                            </button>

                        </div>

                    </div>

                    <div class="calendar-layout">

                        <div class="calendar-board">

                            <div class="calendar-weekdays">
                                <span>Lun</span>
                                <span>Mar</span>
                                <span>Mié</span>
                                <span>Jue</span>
                                <span>Vie</span>
                                <span>Sáb</span>
                                <span>Dom</span>
                            </div>

                            <div class="calendar-grid" id="calendarGrid"></div>

                        </div>

                        <aside class="calendar-day-panel">

                            <h3 id="selectedDayTitle">Tareas del día</h3>
                            <div class="task-list compact" id="selectedDayTasks"></div>

                        </aside>

                    </div>

                </div>

            </section>

            <section class="dashboard-section" id="section-analytics">

                <div class="card placeholder-section-card">
                    <h2>Análisis</h2>
                    <p>Tu vista de productividad ya está en Inicio. Aquí prepararemos métricas más profundas sin alterar el diseño actual.</p>
                </div>

            </section>

            <section class="dashboard-section" id="section-sessions">

                <div class="card">
                    <h2>Sesiones</h2>
                    <p style="color:#9ea4cf;font-size:14px;margin-top:4px;">Historial de tus sesiones de enfoque y descanso</p>
                    <div class="sessions-list" id="sessionsList">
                        <div class="sessions-empty">
                            <i class="ri-timer-flash-line"></i>
                            <p style="color:#9ea4cf;">No hay sesiones registradas aún. Completa un Pomodoro para ver tu historial aquí.</p>
                        </div>
                    </div>
                </div>

            </section>

            <section class="dashboard-section" id="section-achievements">

                <div class="card placeholder-section-card">
                    <h2>Logros</h2>
                    <p>Pronto podrás revisar insignias, rachas y progreso acumulado.</p>
                </div>

            </section>

            <section class="dashboard-section" id="section-settings">

                <div class="card placeholder-section-card">
                    <h2>Ajustes</h2>
                    <p>Espacio reservado para preferencias del dashboard y cuenta.</p>
                </div>

            </section>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="dashboard.js"></script>

    <div id="toastContainer" class="toast-container"></div>

</body>

