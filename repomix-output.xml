    toast.className =
        `toast ${type}`;

    toast.innerHTML = `
        <i class="${icon || icons[type] || icons.info}"></i>
        <span>${message}</span>
    `;

    container.appendChild(toast);

    setTimeout(() => {

        if(toast.parentNode){

            toast.remove();

        }

    }, 4000);

